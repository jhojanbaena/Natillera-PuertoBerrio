# Configuración General del Proyecto
PROJECT_NAME="Sistema de Gestión Natillera API"
API_V1_STR="/api/v1"
DEBUG=False

# Generar una clave privada con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REEMPLAZAR_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL local: generar valores con python backend/setup_local.py desde la raíz.
# Docker Compose recibe este archivo con --env-file backend/.env.
POSTGRES_DB=natillera_db
POSTGRES_USER=natillera
POSTGRES_PASSWORD=REEMPLAZAR_POSTGRES_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg2://natillera:REEMPLAZAR_POSTGRES_PASSWORD@127.0.0.1:5432/natillera_db"

# Orígenes CORS permitidos (separados por coma)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# Producción (Vercel + Neon): establecer explícitamente en el panel de Vercel.
# ENVIRONMENT=production
# AUTO_CREATE_TABLES=False
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# BACKEND_CORS_ORIGINS=https://natillera.example.com
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
